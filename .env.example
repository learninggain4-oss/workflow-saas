# Local dev uses SQLite.
DATABASE_URL=sqlite:///./workflow.db

# Production (Render Postgres). Any of these work - database.py normalises the
# driver to psycopg2, which is the driver in requirements.txt:
#   postgres://...            (legacy prefix)
#   postgresql://...          (bare; driver inferred, so it depends on the
#                             SQLAlchemy version - 2.1 infers psycopg v3)
#   postgresql+psycopg://...   (psycopg v3; not installed, gets rewritten)
# Prefer the explicit form so the intent is visible in the dashboard:
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
# Required in production. The app refuses to boot when this is left at the
# built-in default, because that default is published in the source: anyone can
# forge a login token for any user with it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key

# ---------------------------------------------------------------------------
# DEPLOY HARDENING
# ---------------------------------------------------------------------------
# Set to "production" on Render/Railway (or just set RENDER / RAILWAY_ENVIRONMENT,
# which the platforms set for you). This turns config problems into startup
# failures instead of silent misbehaviour:
#   - SECRET_KEY left at the default      -> refuse to start
#   - DATABASE_URL pointing at SQLite     -> refuse to start (data is wiped each deploy)
# Missing INTEGRATION_ENCRYPTION_KEY or the PADDLE_* vars stay warnings; they only
# break specific features.
# ENVIRONMENT=production

# Comma-separated browser origins allowed to call this API. The defaults cover
# localhost plus this project's known Netlify/Render/Railway hosts.
# ALLOWED_ORIGINS=https://workflow-saas.netlify.app

# Previously the CORS regex accepted ANY *.netlify.app or *.onrender.com origin,
# which with allow_credentials=True let other people's apps on those platforms
# send credentialed requests here. That wildcard is now opt-in - enable only if
# you fully understand the risk.
# CORS_ALLOW_PLATFORM_WILDCARDS=false


# Required to store third-party integration credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this makes existing stored credentials undecryptable - they will be
# reported as status "error" rather than silently failing.
INTEGRATION_ENCRYPTION_KEY=

# Optional comma-separated hostname allowlist that bypasses the SSRF guard, for
# providers whose addresses legitimately fall in a blocked range.
INTEGRATION_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Billing (Paddle Billing / Paddle Classic v2 API)
# ---------------------------------------------------------------------------
# Without these the billing page still loads, but "Upgrade plan" returns 503 and
# the subscription tier can never change.
#
# PADDLE_API_KEY    - server-side API key. NEVER expose this to the browser; the
#                     browser only ever receives a short-lived client token.
# PADDLE_WEBHOOK_SECRET - "Secret key" from the Paddle notification destination.
#                     Used to HMAC-verify every inbound webhook.
# PADDLE_ENV        - "sandbox" (default) or "production"
# PADDLE_PRICE_ID   - the price the checkout transaction is created against
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
PADDLE_PRICE_ID=

# Email configuration for board/team invite emails
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
FROM_EMAIL=alerts@yourdomain.com
BREVO_API_KEY=xkeysib-your-brevo-key

# Frontend
VITE_API_URL=http://localhost:8000
