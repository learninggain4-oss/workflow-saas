# Base URL of the backend API.
#
# Vite inlines this at BUILD time (import.meta.env), not at runtime, so a
# production bundle keeps whatever value was present when `npm run build` ran.
#
#   Local dev -> the backend started with `python -m uvicorn main:app` on 8000
#   Netlify   -> set VITE_API_URL in the Netlify UI (Site settings > Environment)
#
# If this is unset, api.js falls back to
# https://workflow-saas-cof-z.onrender.com, so a frontend that is not configured
# will silently talk to that host instead of your local backend.
VITE_API_URL=http://localhost:8000
